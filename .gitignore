# Large generated simulation runs; keep the directory documentation tracked.
results/simulations/*/

# Generated dataset runs; keep the directory documentation tracked.
data/generated/*/

# Isolated model runs; keep the directory documentation tracked.
results/models/*/

# Isolated analysis runs; keep the directory documentation tracked.
results/analyses/*/

# Combined-workflow logs and manifests are local run outputs.
results/workflows/*/

# Local Claude Code state and agent worktrees.
.claude/

# Local, untracked runs made before the 2026-10 audit (first campaign, invalid).
results/_local_archive_pre_audit/

# Notebooks executed by notebooks/run_zno_notebook.sh.
notebooks/*.executed.ipynb

# GPAW restart files (80+ MB each); never tracked.
*.gpw
